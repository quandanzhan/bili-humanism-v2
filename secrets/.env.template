# 复制为项目根目录 .env，再用 Node 22 的 npm start 加载；本模板不会自行生效。
# 所有认证值、账号、Cookie、令牌留空。仅在本机填写，不提交、不贴入日志。
# 认证生成及首次启动步骤见 ../README.md；详细配置见 ../DEPLOYMENT.md。
# 已存在的进程环境变量优先于 Node --env-file 中的同名项。

# 本地监听；从 standalone-v2 根目录启动，不能从 tools 或 secrets 目录启动。
NODE_ENV=production
PORT=3000
BILI_HUMANISM_HOST=127.0.0.1
BILI_HUMANISM_DATA=./data
# 不设置时为 DATA/legacy；修改 DATA 后此默认值会随之变化。
BILI_HUMANISM_LEGACY=
# 以下路径留空即使用 DATA 下的默认文件；显式相对路径以进程 cwd 为基准。
BILI_HUMANISM_SETTINGS=
BILI_HUMANISM_MODELS=
BILI_HUMANISM_SCHEDULE=
BILI_HUMANISM_NODES=
BILI_HUMANISM_VISION=
BILI_HUMANISM_MCP=
BILI_CREDENTIAL=
PLUGINS_FILE=
# B站集成层也支持以下非空环境凭据覆盖文件；不设置时仍读凭据 JSON。
# secrets loader 本身的 bili 分组仅从文件读取，勿混淆两个接口。
BILI_SESSDATA=
BILI_JCT=
BILI_BUVID3=
BILI_DEDEUSERID=

# 登录三项缺一不可，无默认账号。HASH = scryptSync(password, salt, 64) 的 hex。
AUTH_USER=
AUTH_SALT=
AUTH_HASH=
# 持久随机密钥；留空会生成不记入日志的临时值，重启后会话失效。
SESSION_SECRET=
SESSION_TTL_MS=604800000

# 初次运行关闭自动值班与私信循环；需要时审核持久化设置后分别改为 1。
SCHEDULER_ENABLED=0
REPLY_LOOP=0
# 目标账号不提供示例 UID；由部署者填写自己的授权目标。
REPLY_TALKER=
COMMENT_AT_UID=

# 代理与 CORS：本地 HTTP 使用 0；HTTPS 反代按部署说明改 COOKIE_SECURE=1。
COOKIE_SECURE=0
# 仅在确实隔着一个可信反向代理，且无法绕过代理访问后端时置 1。
TRUST_PROXY=0
CORS_ORIGINS=http://127.0.0.1:3000,http://localhost:3000
CORS_STRICT=1
CORS_ORIGIN_EXTRA=
CORS_HAVP=0
CORS_RESERVED_ORIGINS=
JSON_BODY_LIMIT=1mb
LOG_REQUESTS=0
STATIC_MAX_AGE=0

# SMTP 默认关闭：HOST/ALERT_TO 均留空；填齐两项会在初始化设置时启用告警。
# 已有 settings.json 优先于环境初始化值，不会因修改 env 自动覆盖。
# 示例主机 smtp.example.com、发件人 alerts@example.com、收件人 operator@example.com。
# 示例只说明格式，不能直接投递。启用时填写自己有权使用的真实地址。
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURITY=ssl
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
ALERT_TO=
ALERT_THROTTLE_MS=600000

# 可选旧配置导入，仅显式设置路径时读取；新部署保持空白。
BILI_HUMANISM_V1_ENV=
BILI_HUMANISM_V1_DUTY=
# 仅加载三种旧模型密钥，不会自动创建 models.json 通道。
# SERVICE_ENV 简单解析 KEY=VALUE，不处理 export、引号或变量展开。
SERVICE_ENV=
AMD_API_KEY=
DEEPSEEK_API_KEY=
MODELSCOPE_API_KEY=

# 视觉 API 密钥（可选）；单纯留空不能关闭免密钥外部后端。
# 首次启动前按 README 写入 DATA/vision.json 的 enabled:false 与 backends:[]。
# 文件路径由 BILI_HUMANISM_VISION 覆盖时，须初始化对应文件。
ZHIPU_API_KEY=
DASHSCOPE_API_KEY=
INTERN_API_KEY=
VISION_CACHE_TTL_S=3600
VISION_TIMEOUT_MS=60000
VISION_MAX_PIXELS=1200000

# Worker 留空会禁用 next/result 接口（503）；启用时使用独立随机共享令牌。
WORKER_TOKEN=
WORKER_OFFLINE_MS=60000
BILI_VISION_NAS=0
# 以下仅供独立 scripts/nas-agent.py 使用，Node 不会自动替 Python 加载 .env。
CORE_BASE=https://core.example.com
AGENT_NAME=worker-example
POLL_SEC=5
FFMPEG=ffmpeg

# 浏览器按需安装本地 Chromium；默认关闭页面脚本求值。
BROWSER_ALLOW_EVAL=false
BROWSER_IDLE_MS=90000
BROWSER_NAV_TIMEOUT=45000
BROWSER_MAX_TEXT=60000

# 可选解析节点探测模板地址：不填则停用；格式示例 https://parser.example.com/health。
BILI_HUMANISM_PARSE_HEALTH_URL=
# 可选 Python/ASR/取帧路径；空值用项目及用户缓存目录中的默认值。
BILI_ASR_PY=
BILI_ASR_SCRIPT=
BILI_ASR_CWD=
BILI_ASR_HF_HOME=
BILI_ASR_CACHE=
BILI_FRAMES_PY=
BILI_FRAMES_SCRIPT=
# Linux 路径示例 ./.venv-asr/bin/python；Windows 示例 ./.venv-asr/Scripts/python.exe。
# MCP 用 DATA/mcp-servers.json 配置 stdio 子进程，无默认服务器；不提供通用 MCP_TOKEN。
MCP_RESULT_CHARS=8000
